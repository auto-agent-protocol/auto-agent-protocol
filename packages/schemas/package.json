{
  "name": "@autoagentprotocol/schemas",
  "version": "4.0.0",
  "description": "JSON Schema 2020-12 files for the Auto Agent Protocol",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
