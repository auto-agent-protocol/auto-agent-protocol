    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/auto-agent-protocol/auto-agent-protocol.git",
    "directory": "packages/schemas"
  },
  "homepage": "https://autoagentprotocol.org"
