{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "poppy.schema.json",
    "title": "poppy.json",
    "description": "The discovery document a Company publishes at /.well-known/poppy.json. Spec section 3 (Discovery) and 3.1 (Fields). Unknown fields are allowed: Personal Agents ignore fields they don't recognize.",
    "type": "object",
    "required": ["protocol_version", "organization"],
    "properties": {
        "protocol_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "organization": {
            "type": "object",
            "required": ["name", "domain"],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "domain": {
                    "$ref": "#/$defs/domain"
                },
                "logo_uri": {
                    "$ref": "#/$defs/https_url"
                }
            }
        },
        "auth": {
            "description": "Optional. issuer is required only when the domain's protected resource metadata lists more than one authorization server, and must then be one of them (spec 3.1, 3.2), which is checked separately.",
            "type": "object",
            "properties": {
                "issuer": {
                    "$ref": "#/$defs/https_url"
                },
                "disabled": {
                    "description": "true if the Company offers Personal Agents no sign-in, even though it has an issuer (spec 3.2).",
                    "type": "boolean"
                },
                "scopes": {
                    "description": "Scope descriptions, keyed by scope name, in the same form as an OpenAPI OAuth 2.0 security scheme. Describing offered scopes here or in a listed OpenAPI description is recommended.",
                    "type": "object",
                    "additionalProperties": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "scope_hints": {
                    "description": "Hints about each scope, keyed by scope name, describing the most consequential operation that requires it.",
                    "type": "object",
                    "additionalProperties": {
                        "type": "object",
                        "required": ["changes", "personal_data"],
                        "properties": {
                            "changes": {
                                "enum": ["none", "reversible", "irreversible"]
                            },
                            "personal_data": {
                                "type": "boolean"
                            }
                        }
                    }
                }
            }
        },
        "agent": {
            "type": "object",
            "required": ["protocols"],
            "properties": {
                "protocols": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "required": ["type", "endpoint"],
                        "properties": {
                            "type": {
                                "type": "string",
                                "minLength": 1
                            },
                            "endpoint": {
                                "$ref": "#/$defs/https_url"
                            },
                            "access": {
                                "type": "string",
                                "description": "For a poppy protocol entry, session (the default) or signed_in. Unknown values are ignored as an absent hint (spec 3.2)."
                            }
                        }
                    }
                }
            }
        },
        "feedback": {
            "type": "object",
            "required": ["endpoint"],
            "properties": {
                "endpoint": {
                    "$ref": "#/$defs/https_url"
                }
            }
        },
        "excluded_tasks": {
            "type": "object",
            "required": ["url"],
            "properties": {
                "url": {
                    "$ref": "#/$defs/https_url"
                }
            }
        },
        "web": {
            "type": "object",
            "properties": {
                "browser_session_endpoint": {
                    "$ref": "#/$defs/https_url"
                }
            }
        },
        "apis": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["type", "url", "description"],
                "properties": {
                    "type": {
                        "type": "string",
                        "minLength": 1
                    },
                    "url": {
                        "$ref": "#/$defs/https_url"
                    },
                    "description": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        },
        "skill_index": {
            "$ref": "skill-index.schema.json"
        },
        "extensions": {
            "type": "object",
            "properties": {
                "mediated-sign-in": {
                    "description": "The Mediated Sign-In extension (Mediated Sign-In 2). Version 1 has the credentials to collect, each sent as a token request parameter of that name, and the scopes it can grant. The grant is at the issuer's token_endpoint, which lists https://personalagentprotocol.org/grant/mediated-sign-in in grant_types_supported.",
                    "type": "object",
                    "required": ["version"],
                    "properties": {
                        "version": {
                            "type": "string",
                            "minLength": 1
                        }
                    },
                    "if": {
                        "properties": {
                            "version": {
                                "const": "1"
                            }
                        }
                    },
                    "then": {
                        "required": ["version", "fields", "scopes"],
                        "properties": {
                            "version": {
                                "type": "string",
                                "minLength": 1
                            },
                            "fields": {
                                "type": "array",
                                "minItems": 1,
                                "items": {
                                    "type": "object",
                                    "required": ["name", "label", "secret"],
                                    "properties": {
                                        "name": {
                                            "description": "Not grant_type, scope, resource, a client authentication parameter such as client_id or client_assertion, or a parameter the extension defines, such as sign_in_id.",
                                            "type": "string",
                                            "minLength": 1,
                                            "not": {
                                                "enum": [
                                                    "grant_type",
                                                    "scope",
                                                    "client_id",
                                                    "client_secret",
                                                    "client_assertion",
                                                    "client_assertion_type",
                                                    "resource",
                                                    "sign_in_id",
                                                    "one_time_code"
                                                ]
                                            }
                                        },
                                        "label": {
                                            "type": "string",
                                            "minLength": 1
                                        },
                                        "secret": {
                                            "type": "boolean"
                                        }
                                    }
                                }
                            },
                            "scopes": {
                                "$ref": "#/$defs/scopes"
                            }
                        }
                    }
                }
            },
            "additionalProperties": {
                "type": "object",
                "required": ["version"],
                "properties": {
                    "version": {
                        "type": "string",
                        "minLength": 1
                    },
                    "endpoint": {
                        "$ref": "#/$defs/https_url"
                    }
                }
            }
        }
    },
    "allOf": [
        {
            "anyOf": [
                {
                    "required": ["agent"]
                },
                {
                    "required": ["apis"]
                },
                {
                    "required": ["web"]
                }
            ]
        }
    ],
    "$defs": {
        "https_url": {
            "type": "string",
            "pattern": "^https://[^\\s/?#]+",
            "format": "uri"
        },
        "domain": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+$"
        },
        "scopes": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string",
                "pattern": "^[\\x21\\x23-\\x5B\\x5D-\\x7E]+$"
            }
        }
    }
}
