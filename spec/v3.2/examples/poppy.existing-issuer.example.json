{
  "protocol_version": "0.3",
  "organization": {
    "name": "Demo Toyota",
    "domain": "demo-toyota.example.com"
  },
  "apis": [
    {
      "type": "openapi",
      "url": "https://demo-toyota.example.com/poppy/openapi.yaml",
      "description": "AAP automotive payloads with verified delegated Poppy-Session JWTs. Contact consent is separate."
    }
  ],
  "web": {},
