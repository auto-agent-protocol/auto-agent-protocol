{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draft.autoagentprotocol.invalid/latest/schemas/trade-in-submit-request.schema.json",
  "title": "TradeInSubmitRequest",
  "description": "Describe one trade-in vehicle through MCP, A2A or PAP and, where the dealer supports it, receive an immediate valuation. Year, make, model, wear condition and mileage are required. Customer contact data is optional: without it the request is an anonymous estimate and the dealer stores no contact data and makes no follow-up; with it, a consent grant scoped to trade_in_submission is required. A dealer that requires contact declares contact_required in its capabilities.",
  "type": "object",
  "properties": {
    "type": {
      "const": "trade_in.submit.request",
      "description": "AAP message type discriminator."
    },
    "vehicle": {
      "allOf": [
        {
          "$ref": "./vehicle.schema.json"
        }
      ],
      "type": "object",
      "required": [
        "year",
        "make",
        "model",
        "condition",
        "mileage"
      ],
      "properties": {
        "condition": {
          "enum": [
            "excellent",
            "good",
            "fair",
            "poor"
          ]
        },
        "rebates": false
      },
      "description": "The vehicle offered for trade-in. Required: year, make, model, wear condition (excellent, good, fair or poor) and mileage in mileage_unit (mi when omitted). Optional details that improve a valuation: vin, trim, exterior_color, driveline, transmission, displacement_cc, fuel and horsepower. Pass only what the customer provided; never invent a VIN or equipment."
    },
    "customer": {
      "$ref": "./customer.schema.json",
      "description": "Optional contact data. When present, consent is required and the dealer may follow up on the permitted channels."
    },
    "consent": {
      "$ref": "./consent-grant.schema.json",
      "description": "Required when customer is present. `scope` MUST be [\"trade_in_submission\"]."
    },
    "vehicle_of_interest": {
      "$ref": "./vehicle.schema.json",
      "description": "Optional vehicle the customer intends to buy; some dealers value a trade-in in the context of a purchase. When condition is set it MUST be new, used or cpo."
    },
    "message": {
      "type": "string",
      "maxLength": 4000,
      "description": "Optional free-text note about the vehicle, such as accident history or recent service."
    },
    "source_agent": {
      "$ref": "./lead-submit-request.schema.json#/properties/source_agent"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 / RFC 3339 timestamp at which the buyer agent finalized this submission."
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Required client-generated key (UUID recommended) for this trade-in submission. Preserve the key and payload after a timeout or session renewal. Deduplicate for at least 24 hours by dealer and verified caller, including the stable PAP User ID where applicable; anonymous calls use dealer and key. The same caller and key across bindings return the complete original result with data.replayed true; a changed payload returns IDEMPOTENCY_CONFLICT. A replay creates no new record, valuation or delivery."
    }
  },
  "required": [
    "type",
    "vehicle",
    "source_agent",
    "idempotency_key"
  ],
  "dependentRequired": {
    "customer": [
      "consent"
    ],
    "consent": [
      "customer"
    ]
  },
  "additionalProperties": false,
  "allOf": [
    {
      "description": "The consent grant must be scoped to trade-in submission",
      "properties": {
        "consent": {
          "properties": {
            "scope": {
              "const": [
                "trade_in_submission"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "vehicle_of_interest"
        ],
        "properties": {
          "vehicle_of_interest": {
            "type": "object",
            "required": [
              "condition"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "vehicle_of_interest": {
            "properties": {
              "condition": {
                "enum": [
                  "new",
                  "used",
                  "cpo"
                ]
              }
            }
          }
        }
      },
      "description": "vehicle_of_interest.condition (when set) must be in the sale-condition vocabulary"
    },
    {
      "if": {
        "properties": {
          "consent": {
            "properties": {
              "allowed_channels": {
                "contains": {
                  "const": "email"
                }
              }
            },
            "required": [
              "allowed_channels"
            ]
          }
        },
        "required": [
          "consent"
        ]
      },
      "then": {
        "properties": {
          "customer": {
            "required": [
              "email"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "customer": {
            "properties": {
              "preferred_contact": {
                "const": "email"
              }
            },
            "required": [
              "preferred_contact"
            ]
          }
        },
        "required": [
          "customer"
        ]
      },
      "then": {
        "properties": {
          "consent": {
            "properties": {
              "allowed_channels": {
                "contains": {
                  "const": "email"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "consent": {
            "properties": {
              "allowed_channels": {
                "contains": {
                  "const": "phone"
                }
              }
            },
            "required": [
              "allowed_channels"
            ]
          }
        },
        "required": [
          "consent"
        ]
      },
      "then": {
        "properties": {
          "customer": {
            "required": [
              "phone"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "customer": {
            "properties": {
              "preferred_contact": {
                "const": "phone"
              }
            },
            "required": [
              "preferred_contact"
            ]
          }
        },
        "required": [
          "customer"
        ]
      },
      "then": {
        "properties": {
          "consent": {
            "properties": {
              "allowed_channels": {
                "contains": {
                  "const": "phone"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "consent": {
            "properties": {
              "allowed_channels": {
                "contains": {
                  "const": "sms"
                }
              }
            },
            "required": [
              "allowed_channels"
            ]
          }
        },
        "required": [
          "consent"
        ]
      },
      "then": {
        "properties": {
          "customer": {
            "required": [
              "phone"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "customer": {
            "properties": {
              "preferred_contact": {
                "const": "sms"
              }
            },
            "required": [
              "preferred_contact"
            ]
          }
        },
        "required": [
          "customer"
        ]
      },
      "then": {
        "properties": {
          "consent": {
            "properties": {
              "allowed_channels": {
                "contains": {
                  "const": "sms"
                }
              }
            }
          }
        }
      }
    }
  ]
}
