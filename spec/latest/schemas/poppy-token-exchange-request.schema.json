{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draft.autoagentprotocol.invalid/latest/schemas/poppy-token-exchange-request.schema.json",
  "title": "PoppyTokenExchangeRequest",
  "description": "RFC 8693 form fields for PAP 0.3 non-DPoP MCP only. Send client authentication and a fresh Session-key DPoP header without ath. Verify the subject token belongs to that client and key; resource must equal the advertised MCP URL. Scopes cannot expand.",
  "type": "object",
  "required": [
    "grant_type",
    "subject_token",
    "subject_token_type",
    "resource",
    "client_id",
    "client_assertion_type",
    "client_assertion"
  ],
  "properties": {
    "client_id": {
      "type": "string",
      "format": "uri",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^/?#@\\s]+(?:[/?#][^\\s]*)?$"
    },
    "client_assertion_type": {
      "const": "urn:ietf:params:oauth:client-assertion-type:jwt-bearer"
    },
    "client_assertion": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
      "description": "Compact signed JWS. Structural validation is not signature verification."
    },
    "session_id": false,
    "resource": {
      "type": "string",
      "format": "uri",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^/?#@\\s]+(?:[/?][^#\\s]*)?$"
    },
    "scope": {
      "type": "string",
      "pattern": "^(?!poppy:)[\\x21\\x23-\\x5B\\x5D-\\x7E]+( (?!poppy:)[\\x21\\x23-\\x5B\\x5D-\\x7E]+)*$"
    },
    "grant_type": {
      "const": "urn:ietf:params:oauth:grant-type:token-exchange"
    },
    "subject_token": {
      "type": "string",
      "minLength": 1
    },
    "subject_token_type": {
      "const": "urn:ietf:params:oauth:token-type:access_token"
    }
  },
  "additionalProperties": true
}
