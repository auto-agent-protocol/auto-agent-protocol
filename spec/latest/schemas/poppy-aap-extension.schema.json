{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draft.autoagentprotocol.invalid/latest/schemas/poppy-aap-extension.schema.json",
  "title": "PoppyAapExtension",
  "description": "One entry of the autoagentprotocol.org/aap list in a PAP 1.0 poppy.json extensions object (spec 3.3). The entry fields and bridge version 1 are unchanged from AAP 3.x; only the PAP container became a list with one entry per extension major version.",
  "type": "object",
  "properties": {
    "version": {
      "const": "1"
    },
    "agent_card": {
      "type": "string",
      "format": "uri",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^/?#@\\s]+(?:[/?#][^\\s]*)?$"
    },
    "mcp": {
      "type": "string",
      "format": "uri",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^/?#@\\s]+(?:[/?#][^\\s]*)?$"
    },
    "openapi": {
      "type": "string",
      "format": "uri",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^/?#@\\s]+(?:[/?#][^\\s]*)?$"
    },
    "api_catalog": {
      "type": "string",
      "format": "uri",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^/?#@\\s]+(?:[/?#][^\\s]*)?$"
    },
    "documentation": {
      "type": "string",
      "format": "uri",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^/?#@\\s]+(?:[/?#][^\\s]*)?$"
    },
    "aap_version": {
      "type": "string",
      "minLength": 1,
      "description": "AAP contract release, distinct from this discovery extension version and the PAP draft version."
    },
    "llms_txt": {
      "type": "string",
      "format": "uri",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^/?#@\\s]+(?:/[^?#\\s]*)?$"
    }
  },
  "required": [
    "version",
    "agent_card"
  ],
  "additionalProperties": true
}
