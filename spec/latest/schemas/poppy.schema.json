{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draft.autoagentprotocol.invalid/latest/schemas/poppy.schema.json",
  "title": "AAPPoppyDiscovery",
  "description": "AAP 3.1 PAP draft 0.3 publication profile. Requires a guest OAuth issuer, native OpenAPI API and an AAP bridge linking the matching Agent Card, public MCP endpoint and llms.txt. Native PAP MCP session support remains conditional on advertising an MCP API entry.",
  "allOf": [
    {
      "$ref": "./poppy-document.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": "0.3"
        },
        "auth": {
          "type": "object",
          "properties": {
            "issuer": {
              "type": "string"
            },
            "direct": false,
            "device": false,
            "custom_scopes": false,
            "scope_hints": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "changes": {
                    "enum": [
                      "none",
                      "reversible",
                      "irreversible"
                    ]
                  }
                }
              }
            }
          },
          "required": [
            "issuer"
          ],
          "additionalProperties": true
        },
        "apis": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "openapi",
                  "mcp"
                ]
              }
            }
          },
          "contains": {
            "type": "object",
            "properties": {
              "type": {
                "const": "openapi"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": true
          }
        },
        "extensions": {
          "type": "object",
          "properties": {
            "autoagentprotocol.org/aap": {
              "allOf": [
                {
                  "$ref": "./poppy-aap-extension.schema.json"
                },
                {
                  "properties": {
                    "aap_version": {
                      "const": "0.0.0-dev"
                    },
                    "mcp": {
                      "type": "string",
                      "format": "uri",
                      "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^/?#@\\s]+(?:/[^?#\\s]*)?$"
                    }
                  },
                  "required": [
                    "aap_version",
                    "mcp",
                    "llms_txt"
                  ]
                }
              ]
            }
          },
          "required": [
            "autoagentprotocol.org/aap"
          ],
          "additionalProperties": true
        },
        "agent": {
          "type": "object",
          "properties": {
            "protocols": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "poppy"
                  }
                }
              }
            }
          }
        }
      },
      "required": [
        "auth",
        "apis",
        "extensions"
      ],
      "additionalProperties": true
    }
  ]
}
