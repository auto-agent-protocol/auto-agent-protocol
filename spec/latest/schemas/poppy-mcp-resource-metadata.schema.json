{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draft.autoagentprotocol.invalid/latest/schemas/poppy-mcp-resource-metadata.schema.json",
  "title": "PoppyMCPResourceMetadata",
  "description": "PAP 0.3 RFC 9728 metadata for native MCP. Cross-check resource against the exact advertised MCP URL and authorization_servers against auth.issuer. Advertised DPoP support requires ES256; without it the issuer must support token exchange.",
  "type": "object",
  "required": [
    "resource",
    "authorization_servers"
  ],
  "properties": {
    "resource": {
      "type": "string",
      "format": "uri",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^/?#@\\s]+(?:[/?][^#\\s]*)?$"
    },
    "authorization_servers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^/?#@\\s]+(?:/[^?#\\s]*)?$"
      }
    },
    "dpop_signing_alg_values_supported": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "contains": {
        "const": "ES256"
      },
      "uniqueItems": true,
      "description": "Optional advertisement; when present it must include ES256. ES256 proof verification is mandatory even when this field is omitted."
    },
    "scopes_supported": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!poppy:)[\\x21\\x23-\\x5B\\x5D-\\x7E]+$"
      }
    },
    "bearer_methods_supported": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "contains": {
        "const": "header"
      }
    }
  },
  "additionalProperties": true
}
