{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draft.autoagentprotocol.invalid/latest/schemas/poppy-alternative.schema.json",
  "title": "PoppyAlternative",
  "description": "Another way to do a task: in an excluded task, or as the body of a 200 response to a feedback report. Spec 9.2 (Alternatives). Personal Agents skip reference types they don't recognize. Web references can point to any HTTPS website or app and don't authorize sending Session JWTs or access tokens. OpenAPI and MCP references name APIs listed in the Company's poppy.json.",
  "type": "object",
  "anyOf": [
    {
      "required": [
        "instructions"
      ]
    },
    {
      "required": [
        "references"
      ]
    }
  ],
  "properties": {
    "instructions": {
      "type": "string",
      "minLength": 1
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "$ref": "./poppy-document.schema.json#/$defs/https_url"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "openapi"
              }
            }
          },
          "then": {
            "required": [
              "url",
              "operation_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "mcp"
              }
            }
          },
          "then": {
            "required": [
              "url",
              "tool"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "web"
              }
            }
          },
          "then": {
            "required": [
              "url"
            ]
          }
        }
      ]
    }
  },
  "$comment": "Adapted from personal-agent-protocol at 6fb46d381ac1b94265795132af13848ec442b6f6 (Apache-2.0); unmodified independent fixtures and hashes in tests/upstream/poppy/published-0.3. JSON Schema does not verify cryptography or runtime requirements."
}
