{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoagentprotocol.org/v3.0/schemas/poppy-guest-token-response.schema.json",
  "title": "PoppyGuestTokenResponse",
  "description": "Successful JWT bearer guest grant. Always a DPoP token; no account scopes or credentials.",
  "allOf": [
    {
      "$ref": "./poppy-session-token.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "token_type": {
          "const": "DPoP"
        },
        "scope": false,
        "refresh_token": false,
        "refresh_token_expires_in": false
      }
    }
  ]
}
