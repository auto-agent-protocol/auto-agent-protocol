{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoagentprotocol.org/v3.1/schemas/poppy-oauth-metadata.schema.json",
  "title": "PoppyOAuthMetadata",
  "type": "object",
  "properties": {
    "issuer": {
      "type": "string",
      "format": "uri",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^/?#@\\s]+(?:/[^?#\\s]*)?$"
    },
    "token_endpoint": {
      "type": "string",
      "format": "uri",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^/?#@\\s]+(?:[/?#][^\\s]*)?$"
    },
    "revocation_endpoint": {
      "type": "string",
      "format": "uri",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^/?#@\\s]+(?:[/?#][^\\s]*)?$"
    },
    "authorization_endpoint": {
      "type": "string",
      "format": "uri",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^/?#@\\s]+(?:[/?#][^\\s]*)?$"
    },
    "device_authorization_endpoint": {
      "type": "string",
      "format": "uri",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^/?#@\\s]+(?:[/?#][^\\s]*)?$"
    },
    "grant_types_supported": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "allOf": [
        {
          "contains": {
            "const": "urn:ietf:params:oauth:grant-type:jwt-bearer"
          }
        },
        {
          "contains": {
            "const": "refresh_token"
          }
        }
      ]
    },
    "token_endpoint_auth_methods_supported": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "contains": {
        "const": "private_key_jwt"
      }
    },
    "dpop_signing_alg_values_supported": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "contains": {
        "const": "ES256"
      },
      "uniqueItems": true,
      "description": "Optional advertisement; when present it must include ES256. ES256 proof verification is mandatory even when this field is omitted."
    },
    "poppy_domains": false,
    "protected_resources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^/?#@\\s]+(?:[/?][^#\\s]*)?$"
      },
      "description": "Includes https://{organization.domain} with no port, path, query or trailing slash, compared with hostname case ignored only. May also list service resources."
    },
    "scopes_supported": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!poppy:)[\\x21\\x23-\\x5B\\x5D-\\x7E]+$"
      }
    }
  },
  "required": [
    "issuer",
    "token_endpoint",
    "revocation_endpoint",
    "grant_types_supported",
    "protected_resources"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "grant_types_supported": {
            "contains": {
              "const": "authorization_code"
            }
          }
        },
        "required": [
          "grant_types_supported"
        ]
      },
      "then": {
        "required": [
          "authorization_endpoint",
          "scopes_supported"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "grant_types_supported": {
            "contains": {
              "const": "urn:ietf:params:oauth:grant-type:device_code"
            }
          }
        },
        "required": [
          "grant_types_supported"
        ]
      },
      "then": {
        "required": [
          "device_authorization_endpoint",
          "scopes_supported"
        ]
      }
    }
  ],
  "description": "PAP 0.3 issuer metadata. Direct and Device Sign-In are selected by grant_types_supported. Cross-check organization resources, scope descriptions, mediated sign-in and native MCP resource metadata separately."
}
