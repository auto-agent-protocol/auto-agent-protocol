{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoagentprotocol.org/v3.1/schemas/poppy-token-exchange-response.schema.json",
  "title": "PoppyTokenExchangeResponse",
  "description": "Resource-bound MCP Bearer token for the same Session and no broader scopes than the subject DPoP token. A signed-out exchange omits scope.",
  "allOf": [
    {
      "$ref": "./poppy-session-token.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "token_type": {
          "const": "Bearer"
        }
      },
      "required": [
        "issued_token_type"
      ]
    }
  ]
}
