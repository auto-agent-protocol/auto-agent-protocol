{
  "name": "autoagentprotocol",
  "version": "3.2.0",
  "private": true,
  "description": "Auto Agent Protocol — the open contract for AI agents to talk to car dealerships",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "start": "pnpm run generate && pnpm run copy-static && tsx tools/start-docs.ts",
    "build": "pnpm run validate && pnpm run check:releases && pnpm run check:images && pnpm run generate && pnpm run copy-static && tsx tools/build-docs.ts && pnpm run check:build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "generate": "pnpm run generate:draft && pnpm run generate:llms",
    "generate:draft": "pnpm run generate:types && pnpm run generate:openapi && pnpm run generate:mcp",
    "generate:types": "tsx tools/generate-types.ts",
    "generate:openapi": "tsx tools/generate-openapi.ts",
    "generate:mcp": "tsx tools/generate-mcp-manifest.ts",
    "generate:llms": "tsx tools/generate-llms.ts",
    "generate:images": "tsx tools/generate-images.ts",
    "check:images": "tsx tools/generate-images.ts --check",
    "generate:branding": "node tools/generate-branding.mjs",
    "check:branding": "node tools/check-branding.mjs",
    "validate": "pnpm run validate:manifest && pnpm run validate:schemas && pnpm run validate:examples && pnpm run validate:partners",
    "validate:manifest": "tsx tools/validate-manifest.ts",
    "validate:schemas": "tsx tools/validate-schemas.ts",
    "validate:examples": "tsx tools/validate-examples.ts",
    "validate:partners": "tsx tools/check-partners.ts",
    "freeze-check": "tsx tools/freeze-check.ts",
    "check:releases": "tsx tools/check-releases.ts",
    "check:build": "tsx tools/check-build.ts",
    "release:prepare": "tsx tools/release-prepare.ts",
    "test:contract": "node --import tsx --test tests/contract/*.test.ts",
    "test:release": "node --import tsx --test tests/release/*.test.ts",
    "copy-static": "tsx tools/copy-static.ts",
    "check:packages": "tsx tools/check-packages.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/plugin-client-redirects": "^3.10.2",
    "@docusaurus/plugin-content-docs": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-common": "^3.10.2",
    "@docusaurus/theme-mermaid": "^3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/react": "^19.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "glob": "^14.0.6",
    "json-schema-to-typescript": "^16.0.0",
    "sharp": "0.35.5",
    "structured-headers": "2.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  }
}
